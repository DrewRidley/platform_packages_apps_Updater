<?xml version="1.0" encoding="utf-8"?>
<!-- Pinning intentionally omitted. Upstream pins releases.grapheneos.org to ISRG
     roots to defend a large user base against TARGETED UPDATE DENIAL via a
     mis-issued cert. OTA integrity here comes from the payload signature checked
     against keys baked into the running system, not from TLS, so a MITM can only
     deny service. Meanwhile Cloudflare rotates issuers (ISRG / Google Trust
     Services) outside our control, making a stale pin the likelier outage. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
